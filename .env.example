# Copy this file to .env and fill in your values

# --- Scheduling ---
# How often to run checks (in minutes)
CHECK_INTERVAL_MINUTES=15

# --- Notifications ---
# Set to "mac" for desktop banner, "sms" for Twilio (or "both")
NOTIFY_VIA=mac

# --- Twilio (SMS) - optional ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Alpha Vantage - optional ---
ALPHA_VANTAGE_API_KEY=

# --- Watchlist ---
# Comma-separated tickers to monitor
WATCHLIST=AAPL,MSFT,SPY
