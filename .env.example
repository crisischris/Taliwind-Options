# Copy this file to .env and fill in your values

# --- Scheduling ---
# How often to run price alert checks (in minutes)
CHECK_INTERVAL_MINUTES=15

# --- Notifications ---
# Set to "mac" for desktop banner, "sms" for Twilio (or "both")
NOTIFY_VIA=mac

# --- Twilio (SMS) - optional ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Alpha Vantage - optional ---
ALPHA_VANTAGE_API_KEY=

# --- Watchlist (used by price alerts) ---
# Comma-separated tickers to monitor
WATCHLIST=AAPL,MSFT,SPY

# --- Gainer Put Scanner ---
# Minimum 1-year gain % to flag a ticker (default: 500 = 500%)
GAINER_MIN_GAIN_PCT=500
# Max put ask price as a fraction of stock price (default: 0.05 = 5%)
GAINER_PUT_MAX_COST_PCT=0.05
# Max implied volatility on the put (default: 0.60 = 60%)
GAINER_PUT_MAX_IV=0.60
# Minimum open interest for liquidity (default: 10)
GAINER_PUT_MIN_OI=10
# DTE window for options expiration (default: 60–180 days out)
GAINER_PUT_MIN_DTE=60
GAINER_PUT_MAX_DTE=180
